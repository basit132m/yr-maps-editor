# Copy to .env and edit before the first start.

# The domain this site answers on. Caddy requests the certificate for it,
# so its DNS A record must already point at this server.
SITE_DOMAIN=yrmapseditor.site

# Let's Encrypt uses this to warn you about renewal problems.
ACME_EMAIL=you@example.com

# Shown in the page header.
YRME_SITE_NAME=YR Maps Editor

# Seconds an upload is kept before it is deleted (1800 = 30 minutes).
YRME_UPLOAD_TTL=1800

# --- accounts -------------------------------------------------------------

# Require an account before a map can be edited.
# Off by default. The tool takes about half a minute to use without one, and
# a forced signup costs far more visitors than it gains. Turn it on only
# once the account features are worth the friction.
YRME_REQUIRE_LOGIN=0

# How long a signed-in session lasts without being used.
YRME_SESSION_DAYS=30

# Where the database file lives. Keep it on the mounted volume, or every
# account disappears when the container is rebuilt.
# YRME_DB_PATH=/var/lib/yrme/yrme.db
