# Caddy obtains and renews the HTTPS certificate automatically, so there is
# no certbot step and nothing to remember to renew.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Refuse oversized uploads at the edge, before they reach Python.
	request_body {
		max_size 21MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:8000

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
